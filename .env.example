# Vebanet Storefront Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# MEDUSA BACKEND (Required)
# ============================================
# URL to your Medusa backend API
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# ============================================
# STRIPE (Required for checkout)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# ANALYTICS (Optional)
# ============================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Analytics (auto-enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features for testing
# NEXT_PUBLIC_ENABLE_REVIEWS=true
# NEXT_PUBLIC_ENABLE_WISHLIST=true

# ============================================
# SITE CONFIG (Optional)
# ============================================
# Override default site URL (useful for previews)
# NEXT_PUBLIC_SITE_URL=https://vebanet.com
