# Medusa Backend Environment Template
# Copy this to .env and fill in your values

# Database (PostgreSQL) - REQUIRED
DATABASE_URL=postgres://user:password@localhost:5432/vebanet_medusa

# Redis (optional)
REDIS_URL=

# CORS
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000

# Security (CHANGE IN PRODUCTION!)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Admin
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# File Storage (S3-Compatible) - Optional
# Leave empty to use local storage
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Resend Email Integration
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=Vebanet <noreply@vebanet.com>
FRONTEND_URL=http://localhost:3000
